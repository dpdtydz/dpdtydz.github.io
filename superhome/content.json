{
  "generated": {{ site.time | date_to_xmlschema | jsonify }},
  "posts": [{% for post in site.posts %}{"path": {{ post.path | jsonify }}, "title": {{ post.title | jsonify }}, "date": {{ post.date | date: '%Y-%m-%d' | jsonify }}, "url": {{ post.url | relative_url | jsonify }}, "tags": {{ post.tags | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}],
  "projects": {{ site.data.projects | jsonify }}
}
